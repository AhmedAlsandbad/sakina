-- Run after deploying push-dispatch and setting its CRON_SECRET environment secret.
-- Replace the two placeholder values locally/in the Supabase SQL editor; never commit real secrets.

create extension if not exists pg_cron;
create extension if not exists pg_net;
create extension if not exists supabase_vault;

-- Run these two lines ONCE with your real values in the Supabase SQL editor:
-- select vault.create_secret('https://YOUR_PROJECT_REF.supabase.co', 'sakina_project_url');
-- select vault.create_secret('A_LONG_RANDOM_CRON_SECRET', 'sakina_cron_secret');

select cron.schedule(
  'sakina-push-dispatch',
  '* * * * *',
  $$
  select net.http_post(
    url := (
      select decrypted_secret
      from vault.decrypted_secrets
      where name = 'sakina_project_url'
      limit 1
    ) || '/functions/v1/push-dispatch',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'x-sakina-cron-secret', (
        select decrypted_secret
        from vault.decrypted_secrets
        where name = 'sakina_cron_secret'
        limit 1
      )
    ),
    body := '{}'::jsonb,
    timeout_milliseconds := 10000
  ) as request_id;
  $$
);

-- Optional cleanup jobs: retain 14 days of delivery logs and 3 days of prayer cache.
select cron.schedule(
  'sakina-push-log-cleanup',
  '17 3 * * *',
  $$ delete from public.push_delivery_log where created_at < now() - interval '14 days' $$
);

select cron.schedule(
  'sakina-prayer-cache-cleanup',
  '23 3 * * *',
  $$ delete from public.prayer_day_cache where prayer_date < current_date - 3 $$
);
